{
  "manifest_version": 1,
  "as_of": "2026-07-22",
  "repo": "fcrocker-nyc/dirk-adams-honest-cattle-data",
  "raw_base": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/",
  "default_branch": "main",
  "encoding": "utf-8",
  "content_type": "application/json",
  "docs": "FEEDS.md",
  "note": "Platform-neutral feed manifest for the HonestCattle apps. Every feed is plain UTF-8 JSON over HTTPS with no platform-specific encoding, so the iOS and Android clients consume an identical surface. Fetch this file first to discover feeds instead of hard-coding URLs.",
  "cadence_note": "Times are UTC. Feeds only commit when content changes, so a client should treat refresh_utc as 'not before' and use each payload's own date/as_of field as the source of truth.",
  "feeds": [
    {
      "id": "county_conditions_mt",
      "title": "Montana county conditions (snowpack / moisture / drought / forage)",
      "group": "conditions",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url_pattern": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/{key}.json",
      "index": "counties.montana",
      "count": 56,
      "cadence": "daily",
      "refresh_utc": "11:30",
      "schema_doc": "FEEDS.md#county-conditions",
      "nullable_blocks": [
        "precip_ytd",
        "drought",
        "streamflow",
        "soil_moisture",
        "precip_anomaly",
        "hay_pasture"
      ],
      "notes": "Additive/nullable blocks: a missing data source serializes as null, never as an absent key on the core fields."
    },
    {
      "id": "county_roster_mt",
      "title": "Montana county roster (name / page slug / region / data flags)",
      "group": "conditions",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/counties.json",
      "cadence": "on-change",
      "schema_doc": "FEEDS.md#county-roster",
      "notes": "Static list. For the county->feed-URL map use the counties.montana index in this manifest (roster 'slug' is the WordPress page slug, NOT the data-file key)."
    },
    {
      "id": "vegetation_rap",
      "title": "Rangeland vegetation VR + irrigated hay/pasture (RAP percentiles)",
      "group": "conditions",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/vegetation.json",
      "cadence": "weekly",
      "refresh_utc": "Mon 12:00",
      "schema_doc": "FEEDS.md#vegetation",
      "notes": "Per-county vr / hay_pasture keyed by county. May lag current year (RAP publication delay); carries vr_status/vr_note explaining any null."
    },
    {
      "id": "county_conditions_tx",
      "title": "Texas county conditions",
      "group": "conditions",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url_pattern": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/texas/{key}.json",
      "index": "counties.texas",
      "count": 39,
      "cadence": "daily",
      "refresh_utc": "11:50",
      "schema_doc": "FEEDS.md#county-conditions"
    },
    {
      "id": "county_roster_tx",
      "title": "Texas county roster",
      "group": "conditions",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/texas_counties.json",
      "cadence": "on-change",
      "schema_doc": "FEEDS.md#county-roster"
    },
    {
      "id": "market_forecast",
      "title": "4-week calf-price market forecast",
      "group": "market",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/forecasts_recent.json",
      "cadence": "daily",
      "refresh_utc": "13:30",
      "schema_doc": "FEEDS.md#market-forecast",
      "notes": "Rolling window of the 4 most recent weekly forecasts. A heifer band not yet published serializes as null."
    },
    {
      "id": "auction_video_latest",
      "title": "Consolidated video-auction card (Market tab video card)",
      "group": "market",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/auction/video_latest.json",
      "cadence": "daily",
      "refresh_utc": "12:00",
      "schema_doc": "FEEDS.md#auction-latest",
      "notes": "Freshest of the tracked video houses; carries season{} banner + series_roster + per-house calf-band summary. Video sales are seasonal (~Apr-Oct); off-season it holds the last sale."
    },
    {
      "id": "auction_house_latest",
      "title": "Per-house latest auction reports",
      "group": "market",
      "consumers": [
        "ios-app",
        "android-app",
        "wordpress"
      ],
      "url_pattern": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/auction/{house}_latest.json",
      "houses": [
        "pays",
        "bls",
        "mt_weekly",
        "superior",
        "nlva",
        "wvm",
        "blc_video"
      ],
      "cadence": "daily",
      "refresh_utc": "12:00",
      "schema_doc": "FEEDS.md#auction-latest",
      "notes": "pays/bls/mt_weekly are the year-round Montana yards; the video houses are seasonal and may hold a stale sale_date off-season (check sale_date freshness client-side)."
    },
    {
      "id": "auction_history",
      "title": "Auction price history (trend series)",
      "group": "market",
      "consumers": [
        "ios-app",
        "android-app"
      ],
      "url": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/auction/history.json",
      "cadence": "daily",
      "refresh_utc": "12:00",
      "schema_doc": "FEEDS.md#auction-history"
    },
    {
      "id": "forecast_accuracy",
      "title": "Forecast accuracy scorecard (MPE/MAD/RMSE + calibration)",
      "group": "market",
      "consumers": [
        "ios-app",
        "android-app"
      ],
      "url": "https://raw.githubusercontent.com/fcrocker-nyc/dirk-adams-honest-cattle-data/main/auction/forecast_accuracy.json",
      "cadence": "daily",
      "refresh_utc": "12:00",
      "schema_doc": "FEEDS.md#forecast-accuracy"
    }
  ],
